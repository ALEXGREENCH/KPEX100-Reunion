+// Reunion addition: MMMG has a two-byte prefix, VOIC/EXVO setup chunks,
+// and one or more SEQU streams. See PATCHES.md for the observed resource
+// and independent format reference. Never search past a declared child chunk.
+void SmafFile::parseMmmg_(const uint8_t* p, size_t n) {
+    if (n < 2) return;
+    std::vector<uint8_t> setup;
+    std::vector<std::vector<uint8_t>> sequences;
+    for (size_t pos = 2; pos + 8 <= n;) {
+        const uint8_t* c = p + pos;
+        size_t size = be32(c + 4), body = pos + 8;
+        if (size > n - body) return;
+        if (!std::memcmp(c, "VOIC", 4)) {
+            size_t end = body + size;
+            for (size_t v = body; v + 8 <= end;) {
+                size_t vn = be32(p + v + 4), vb = v + 8;
+                if (vn > end - vb) return;
+                if (!std::memcmp(p + v, "EXVO", 4))
+                    setup.insert(setup.end(), p + vb, p + vb + vn);
+                v = vb + vn;
+            }
+        } else if (!std::memcmp(c, "SEQU", 4) && size && sequences.size() < 32) {
+            sequences.emplace_back(p + body, p + body + size);
+        }
+        pos = body + size;
+    }
+    for (size_t i = 0; i < sequences.size(); ++i) {
+        TrackChunk t;
+        t.trackNumber = int(i);
+        t.formatType = 0;
+        t.isSequTrack = true;
+        t.sequenceData = std::move(sequences[i]);
+        if (i == 0) t.setupData = std::move(setup);
+        tracks.push_back(std::move(t));
+    }
+}
