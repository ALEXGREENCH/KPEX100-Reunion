      "bodyText": " [[[CONTENT-ELEMENT-0]]]    //   배경,   캐릭터   투명배경,   방향키   +5씩   증가  #include   <SScript.h>  #include   \"lala.sbm\"  int   lala_x,   lala_y;  void   init() {             ClearWhite();              lala_x   =   swWidth/2-20;           lala_y=   swHeight/2-20;           CopyImage(0,   0,   background[0]);               //       이미지       출력           SaveLCD();  } void   EVENT_KEYPRESS() {       switch(swData)       {             case   SWAP_KEY_UP   :                            lala_y   -=5;                            break;              case   SWAP_KEY_DOWN   :                            lala_y   +=5;                            break;             case   SWAP_KEY_RIGHT   :                            lala_x   +=5;                            break;                 case   SWAP_KEY_LEFT   :                            lala_x   -=5;                            break;       }  }  void   EVENT_TIMEOUT() {       RestoreLCD();       CopyImage(lala_x,   lala_y,   lala[0]);               //       이미지       출력       Flush(); }  void   main() {       init();       SetTimer(100,   S_TM_REPEAT);               }  ",
