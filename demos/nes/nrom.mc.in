%{
#DEFINE PLAYERVER 4
#DEFINE LCDCLASS 255
#DEFINE IMAGETYPE 255
#DEFINE AUDIOTYPE 255
#DEFINE APPTYPE 1
#DEFINE APPCPID 100
#DEFINE APPID $app_id
#DEFINE APPVER 256
#DEFINE APPNAME "$title"
#DEFINE VALIDCOUNT 255
#DEFINE VALIDTERM 255
%}

// RP2A03/NROM and a frame-stepped PPU for the original cartridge.
int rom[10245], ram[2048], names[2048], palettes[32], oam[256];
int seen[896], hue[16], solid[512], lastSprites[64];
int prgMask, chrStart, vertical, pc, sp, a, x, y, carry, nz, overflow, irqOff, decimal, nmiPending;
int ctrl, mask, vramAddr, addrHigh, addrLatch, oamAddr, vblank, ppuBuffer, pollPc, guestYield;
int buttons, pending, strobe, shift;$pad_state
int ready, failed, originX, originY, paintAt, painted, paletteEpoch, currentColor;
int backgroundEpoch, scannedEpoch, scanLeft;
int viewCol, viewRow, viewCols, viewRows, tileSize, lastSpriteMode;
int viewRight, viewBottom;
int dirtyCells[64], dirtyHead, dirtyCount;
int inNmi;$extra_paint_state
$audio_code$extra_cpu_state

int ROM(int offset) {
    return (rom[offset >> 2] >> ((offset & 3) * 8)) & 255;
}

int NameIndex(int addr) {
    int table;
    table = (addr >> 10) & 3;
    if (!vertical) table = table >> 1;
    return ((table & 1) << 10) | (addr & 1023);
}

int PaletteIndex(int addr) {
    addr &= 31;
    if ((addr & 19) == 16) addr -= 16;
    return addr;
}

int PpuRead(int addr) {
    addr &= 16383;
    if (addr < 8192) return ROM(chrStart + addr);
    if (addr < 16128) return names[NameIndex(addr)];
    return palettes[PaletteIndex(addr)];
}

void QueueCell(int col, int row) {
    if (col < viewCol || col >= viewCol + viewCols ||
        row < viewRow || row >= viewRow + viewRows) return;
    if (dirtyCount == 64) {
        dirtyCount = 0;
        backgroundEpoch++;
    }
    dirtyCells[(dirtyHead + dirtyCount) & 63] = row * 32 + col;
    dirtyCount++;
}

void NameChanged(int index) {
    int cell, col, row, dx, dy;
    if (!painted || !(mask & 8)) { backgroundEpoch++; return; }
    if ((index & 1024) != NameIndex(8192 + (ctrl & 3) * 1024)) return;
    cell = index & 1023;
    if (cell < 960) { QueueCell(cell & 31, cell >> 5); return; }
    cell -= 960;
    col = (cell & 7) * 4;
    row = (cell >> 3) * 4;
    for (dy = 0; dy < 4; dy++)
        for (dx = 0; dx < 4; dx++) QueueCell(col + dx, row + dy);
}

void PpuWrite(int addr, int value) {
    int index;
    addr &= 16383;
    if (addr < 8192) return;
    if (addr < 16128) {
        index = NameIndex(addr);
        if (names[index] != value) {
            names[index] = value;
            NameChanged(index);
        }
    }
    else if (palettes[PaletteIndex(addr)] != (value & 63)) {
        palettes[PaletteIndex(addr)] = value & 63;
        paletteEpoch++;
        backgroundEpoch++;
    }
}

int CpuRead(int addr) {
    int result, value;
    if (addr >= 32768) {
        addr &= prgMask;
        return (rom[4 + (addr >> 2)] >> ((addr & 3) << 3)) & 255;
    }
    if (addr < 8192) return ram[addr & 2047];
    if (addr == 16406) {
        if (strobe) return 64 | (buttons & 1);
        result = shift & 1;
        shift = (shift >> 1) | 128;
        return 64 | result;
    }
    if (addr >= 16384) return 0;
    switch (addr & 7) {
        case 2:
            result = vblank;
            vblank = 0;
            addrLatch = 0;
            return result;
        case 4: return oam[oamAddr];
        case 7:
            result = ppuBuffer;
            value = PpuRead(vramAddr);
            ppuBuffer = value;
            if ((vramAddr & 16383) >= 16128) {
                result = value;
                ppuBuffer = PpuRead(vramAddr - 4096);
            }
            if (ctrl & 4) vramAddr = (vramAddr + 32) & 16383;
            else vramAddr = (vramAddr + 1) & 16383;
            return result;
    }
    return 0;
}

void CpuWrite(int addr, int value) {
    int i, source;
    value &= 255;
    if (addr < 8192) { ram[addr & 2047] = value; return; }
    if (addr == 16406) {
$pad_strobe
        return;
    }
    if (addr == 16404) {
        source = value << 8;
        if (source < 8192) {
            source &= 2047;
            if (oamAddr == 0) {
                for (i = 0; i < 256; i++) oam[i] = ram[source + i];
            } else {
                for (i = 0; i < 256; i++) oam[(oamAddr + i) & 255] = ram[source + i];
            }
        } else {
            for (i = 0; i < 256; i++) oam[(oamAddr + i) & 255] = CpuRead(source + i);
        }
        return;
    }
$apu_write
    switch (addr & 7) {
        case 0:
            if ((value & 128) && !(ctrl & 128) && vblank) nmiPending = 1;
            if ((value ^ ctrl) & 19) backgroundEpoch++;
            ctrl = value;
            break;
        case 1: mask = value; break;
        case 3: oamAddr = value; break;
        case 4: oam[oamAddr] = value; oamAddr = (oamAddr + 1) & 255; break;
        case 5: addrLatch ^= 1; break;
        case 6:
            if (addrLatch) vramAddr = addrHigh | value;
            else addrHigh = (value & 63) << 8;
            addrLatch ^= 1;
            break;
        case 7:
            PpuWrite(vramAddr, value);
            if (ctrl & 4) vramAddr = (vramAddr + 32) & 16383;
            else vramAddr = (vramAddr + 1) & 16383;
            break;
    }
}

int Fetch() {
    int addr;
    addr = pc;
    pc = (pc + 1) & 65535;
    if (addr < 32768) return CpuRead(addr);
    addr &= prgMask;
    return (rom[4 + (addr >> 2)] >> ((addr & 3) << 3)) & 255;
}

int Word() {
    int addr, lo;
    addr = pc;
    // When both bytes share a packed ROM word, use one read. The
    // byte-wise path handles word and mirrored-bank boundaries.
    if (addr >= 32768 && (addr & 3) != 3) {
        pc = (pc + 2) & 65535;
        addr &= prgMask;
        return (rom[4 + (addr >> 2)] >> ((addr & 3) << 3)) & 65535;
    }
    lo = Fetch();
    return lo | (Fetch() << 8);
}

void Branch(int condition) {
    int delta;
    delta = Fetch();
    if (delta & 128) delta -= 256;
    if (condition) pc = (pc + delta) & 65535;
}

void Compare(int left, int right) {
    carry = left >= right;
    nz = (left - right) & 255;
}

void Add(int value) {
    int sum;
    sum = a + value + carry;
    overflow = ((a ^ value ^ 255) & (a ^ sum) & 128) != 0;
    carry = sum > 255;
    a = sum & 255;
    nz = a;
}

void Push(int value) {
    ram[256 + sp] = value & 255;
    sp = (sp - 1) & 255;
}

int Pull() {
    sp = (sp + 1) & 255;
    return ram[256 + sp];
}

int IsZero() {
    return !nz || (nz & 256);
}

int Flags() {
    return (nz & 128) | (overflow << 6) | 32 | (decimal << 3) | (irqOff << 2) |
           (IsZero() ? 2 : 0) | carry;
}

void RestoreFlags(int status) {
    nz = status & 128;
    if (status & 2) nz |= 256;
    else nz |= 1;
    overflow = (status >> 6) & 1;
    decimal = (status >> 3) & 1;
    irqOff = (status >> 2) & 1;
    carry = status & 1;
}

void Nmi() {
    nmiPending = 0;
    inNmi = 1;
    Push(pc >> 8);
    Push(pc);
    Push(Flags());
    irqOff = 1;
    pc = CpuRead(65530) | (CpuRead(65531) << 8);
}

void Bit(int value) {
    nz = value & 128;
    if (!(value & a)) nz |= 256;
    else nz |= 1;
    overflow = (value >> 6) & 1;
}

int StatusAddress(int address) {
    return address >= 8192 && address < 16384 && (address & 7) == 2;
}

${extra_cpu_helpers}void Step() {
    int op, addr, value, destination;
    op = Fetch();
    switch (op) {
        case 5: a |= ram[Fetch()]; nz = a; break;
        case 6: addr = Fetch(); value = ram[addr]; carry = value >> 7;
                nz = (value << 1) & 255; ram[addr] = nz; break;
        case 9: a |= Fetch(); nz = a; break;
        case 10: carry = a >> 7; a = (a << 1) & 255; nz = a; break;
        case 13: a |= CpuRead(Word()); nz = a; break;
        case 16:
            Branch((nz & 128) == 0);
            // A tight LDA PPUSTATUS / BPL loop can wait for the next timer slice.
            if (pc == pollPc) guestYield = 1;
            break;
        case 24: carry = 0; break;
        case 32: addr = Word(); value = pc - 1; Push(value >> 8); Push(value); pc = addr; break;
        case 36: Bit(ram[Fetch()]); break;
        case 37: a &= ram[Fetch()]; nz = a; break;
        case 41: a &= Fetch(); nz = a; break;
        case 42: value = carry; carry = a >> 7; a = ((a << 1) | value) & 255; nz = a; break;
        case 44:
            addr = Word();
            if (StatusAddress(addr)) pollPc = pc - 3;
            else pollPc = -1;
            Bit(CpuRead(addr));
            break;
        case 45: a &= CpuRead(Word()); nz = a; break;
        case 48: Branch(nz & 128); break;
        case 56: carry = 1; break;
        case 64:
            RestoreFlags(Pull());
            value = Pull();
            pc = value | (Pull() << 8);
            inNmi = 0;
            break;
        case 69: a ^= ram[Fetch()]; nz = a; break;
        case 72: Push(a); break;
        case 73: a ^= Fetch(); nz = a; break;
        case 74: carry = a & 1; a >>= 1; nz = a; break;
        case 76: pc = Word(); break;
        case 77: a ^= CpuRead(Word()); nz = a; break;
        case 80: Branch(!overflow); break;
        case 96: value = Pull(); pc = ((value | (Pull() << 8)) + 1) & 65535; break;
        case 101: Add(ram[Fetch()]); break;
        case 102:
            addr = Fetch();
            value = ram[addr] & 1;
            ram[addr] = (ram[addr] >> 1) | (carry << 7);
            carry = value;
            nz = ram[addr];
            break;
        case 104: a = Pull(); nz = a; break;
        case 105: Add(Fetch()); break;
        case 106: value = a & 1; a = (a >> 1) | (carry << 7); carry = value; nz = a; break;
        case 109: Add(CpuRead(Word())); break;
        case 112: Branch(overflow); break;
        case 118:
            addr = (Fetch() + x) & 255;
            value = ram[addr] & 1;
            ram[addr] = (ram[addr] >> 1) | (carry << 7);
            carry = value;
            nz = ram[addr];
            break;
        case 120: irqOff = 1; break;
        case 125: addr = Word(); Add(CpuRead((addr + x) & 65535)); break;
        case 132: ram[Fetch()] = y; break;
        case 133: ram[Fetch()] = a; break;
        case 134: ram[Fetch()] = x; break;
        case 136: y = (y - 1) & 255; nz = y; break;
        case 138: a = x; nz = a; break;
        case 140: addr = Word(); CpuWrite(addr, y); break;
        case 141:$extra_store_abs addr = Word(); CpuWrite(addr, a); break;
        case 142: addr = Word(); CpuWrite(addr, x); break;
        case 144: Branch(!carry); break;
        case 149: addr = Fetch(); ram[(addr + x) & 255] = a; break;
        case 152: a = y; nz = a; break;
        case 153: addr = Word(); CpuWrite((addr + y) & 65535, a); break;
        case 154: sp = x; break;
        case 157: addr = Word(); CpuWrite((addr + x) & 65535, a); break;
        case 160:$extra_load_y y = Fetch(); nz = y; break;
        case 162: x = Fetch(); nz = x; break;
        case 164: y = ram[Fetch()]; nz = y; break;
        case 165: a = ram[Fetch()]; nz = a; break;
        case 166: x = ram[Fetch()]; nz = x; break;
        case 168: y = a; nz = y; break;
        case 169: a = Fetch(); nz = a; break;
        case 170:$extra_transfer_x x = a; nz = x; break;
        case 172: y = CpuRead(Word()); nz = y; break;
        case 173:
            addr = Word();
            if (StatusAddress(addr)) pollPc = pc - 3;
            else pollPc = -1;
            a = CpuRead(addr);
            nz = a;
            break;
        case 174: x = CpuRead(Word()); nz = x; break;
        case 176: Branch(carry); break;
        case 177: addr = Fetch(); a = CpuRead((ram[addr] + (ram[(addr + 1) & 255] << 8) + y) & 65535); nz = a; break;
        case 180: y = ram[(Fetch() + x) & 255]; nz = y; break;
        case 181: a = ram[(Fetch() + x) & 255]; nz = a; break;
        case 185: addr = Word(); a = CpuRead((addr + y) & 65535); nz = a; break;
        case 188: addr = Word(); y = CpuRead((addr + x) & 65535); nz = y; break;
        case 189: addr = Word(); a = CpuRead((addr + x) & 65535); nz = a; break;
        case 192: Compare(y, Fetch()); break;
        case 196: Compare(y, ram[Fetch()]); break;
        case 197: Compare(a, ram[Fetch()]); break;
        case 198: addr = Fetch(); ram[addr] = (ram[addr] - 1) & 255; nz = ram[addr]; break;
        case 200: y = (y + 1) & 255; nz = y; break;
        case 201: Compare(a, Fetch()); break;
        case 202: x = (x - 1) & 255; nz = x; break;
        case 204: Compare(y, CpuRead(Word())); break;
        case 205: Compare(a, CpuRead(Word())); break;
        case 206: addr = Word(); nz = (CpuRead(addr) - 1) & 255; CpuWrite(addr, nz); break;
        case 208: Branch(!IsZero()); break;
        case 214: addr = (Fetch() + x) & 255; ram[addr] = (ram[addr] - 1) & 255; nz = ram[addr]; break;
        case 216: decimal = 0; break;
        case 221: addr = Word(); Compare(a, CpuRead((addr + x) & 65535)); break;
        case 222: addr = (Word() + x) & 65535; nz = (CpuRead(addr) - 1) & 255; CpuWrite(addr, nz); break;
        case 224: Compare(x, Fetch()); break;
        case 228: Compare(x, ram[Fetch()]); break;
        case 230: addr = Fetch(); ram[addr] = (ram[addr] + 1) & 255; nz = ram[addr]; break;
        case 232: x = (x + 1) & 255; nz = x; break;
        case 233: Add(Fetch() ^ 255); break;
        case 234: break;
        case 236: Compare(x, CpuRead(Word())); break;
        case 238: addr = Word(); nz = (CpuRead(addr) + 1) & 255; CpuWrite(addr, nz); break;
        case 240:
            destination = pc - 5;
            addr = pc - 3;
            Branch(IsZero());
            // Polling zero-page RAM through CMP/BEQ can wait for the next NMI.
            if (ctrl & 128) {
                if (pc == addr && CpuRead(addr) == 197) guestYield = 1;
                if (pc == destination &&
                    CpuRead(destination) == 165 && CpuRead(destination + 2) == 197) guestYield = 1;$extra_cpu_wait
            }
            break;
        case 246: addr = (Fetch() + x) & 255; ram[addr] = (ram[addr] + 1) & 255; nz = ram[addr]; break;
        case 254: addr = (Word() + x) & 65535; nz = (CpuRead(addr) + 1) & 255; CpuWrite(addr, nz); break;
${extra_cpu_cases}        default: failed = 1; break;
    }
}

void Color(int value) {
    int rgb, light, wash;
    if (value == currentColor) return;
    currentColor = value;
    rgb = hue[value & 15];
    light = 12 + (value >> 4) * 10;
    wash = 0;
    if (value >= 48) wash = 60;
    if ((value & 15) >= 13) { light = 0; wash = 0; }
    SetColorRGB(((rgb >> 16) * light >> 6) + wash,
                (((rgb >> 8) & 255) * light >> 6) + wash,
                ((rgb & 255) * light >> 6) + wash);
}

int SolidPattern(int pattern) {
    int row, lo, hi, index;
    index = pattern >> 4;
    if (solid[index]) return solid[index] - 2;
    lo = ROM(chrStart + pattern);
    hi = ROM(chrStart + pattern + 8);
    if ((lo == 0 || lo == 255) && (hi == 0 || hi == 255)) {
        for (row = 1; row < 8; row++)
            if (ROM(chrStart + pattern + row) != lo || ROM(chrStart + pattern + row + 8) != hi) break;
        if (row == 8) {
            solid[index] = 2 + (lo & 1) + (hi & 2);
            return solid[index] - 2;
        }
    }
    solid[index] = 1;
    return -1;
}

void DrawTile(int sx, int sy, int pattern, int pal, int flags, int sprite) {
    int row, scan, lo, hi, px, bit, index, start, last;
    int firstX, lastX, firstY, lastY;$sample_locals
    if (!sprite) {
        index = SolidPattern(pattern);
        if (index >= 0) {
            if (index == 0) Color(palettes[0]);
            else Color(palettes[pal + index]);
            FillRect(sx, sy, sx + tileSize - 1, sy + tileSize - 1);
            return;
        }
    }
    firstX = 0;
    firstY = 0;
    lastX = tileSize;
    lastY = tileSize;
    if (sx < originX) firstX = originX - sx;
    if (sy < originY) firstY = originY - sy;
    if (sx + lastX > viewRight) lastX = viewRight - sx;
    if (sy + lastY > viewBottom) lastY = viewBottom - sy;
    if (firstX >= lastX) return;${extra_sprite_fill}${sample_setup}
    for (row = firstY; row < lastY; row++) {
        scan = row;
        $sample_scan
        if (flags & 128) scan = 7 - scan;
        lo = ROM(chrStart + pattern + scan);
        hi = ROM(chrStart + pattern + scan + 8);
        start = firstX;
        last = -1;
        for (px = firstX; px <= lastX; px++) {
            index = -1;
            if (px < lastX) {
                bit = px;
                $sample_bit
                if (!(flags & 64)) bit = 7 - bit;
                index = ((lo >> bit) & 1) | (((hi >> bit) & 1) << 1);
                if (sprite && index == 0) index = -1;
            }
            if (index == last) continue;
            if (last >= 0) {
                if (last == 0) Color(palettes[0]);
                else Color(palettes[pal + last]);
                FillRect(sx + start, sy + row, sx + px - 1, sy + row);
            }
            start = px;
            last = index;
        }
    }
}

${extra_paint_helpers}int PaintCell(int col, int row, int force) {
    int base, attr, tile, pal, key, cell;$extra_cell_locals
    if (col < viewCol || col >= viewCol + viewCols || row < viewRow || row >= viewRow + viewRows) return 0;
    base = 8192 + (ctrl & 3) * 1024;
    tile = PpuRead(base + row * 32 + col);
    attr = PpuRead(base + 960 + (row >> 2) * 8 + (col >> 2));
    pal = ((attr >> ((row & 2) * 2 + (col & 2))) & 3) * 4;
$cell_key
    cell = (row - viewRow) * viewCols + col - viewCol;
$cell_compare
    DrawTile(originX + (col - viewCol) * tileSize, originY + (row - viewRow) * tileSize,
             ((ctrl & 16) << 8) + tile * 16, pal, 0, 0);
    return 1;
}

int RestoreSprite(int signature, int mode) {
    int col, row, sx, sy, changed, height;
    if (signature == -1) return 0;
    sx = signature & 255;
    sy = ((signature >> 8) & 255) + 1;
    height = 8;
    if (mode & 32) height = 16;
    changed = 0;
    for (row = sy >> 3; row <= (sy + height - 1) >> 3; row++)
        for (col = sx >> 3; col <= (sx + 7) >> 3; col++) changed |= PaintCell(col, row, 1);
    return changed;
}

int SpriteSignature(int offset) {
    int sy, sx, height;
    if (!(mask & 16)) return -1;
    sy = oam[offset] + 1;
    sx = oam[offset + 3];
    height = 8;
    if (ctrl & 32) height = 16;
    if (sy >= 240 || sy >= (viewRow + viewRows) * 8 || sy + height <= viewRow * 8 ||
        sx >= (viewCol + viewCols) * 8 || sx + 8 <= viewCol * 8) return -1;
    return (oam[offset + 2] << 24) | (oam[offset + 1] << 16) | ((sy - 1) << 8) | sx;
}

void PaintSprite(int signature) {
    int sx, sy, tile, flags, pal, pattern, top, bottom;
    if (signature == -1) return;
    sx = originX + (((signature & 255) - viewCol * 8) * tileSize >> 3);
    sy = originY + ((((signature >> 8) & 255) + 1 - viewRow * 8) * tileSize >> 3);
    tile = (signature >> 16) & 255;
    flags = (signature >> 24) & 255;
    pal = 16 + (flags & 3) * 4;
    if (!(ctrl & 32)) {
        DrawTile(sx, sy, ((ctrl & 8) << 9) + tile * 16, pal, flags, 1);
        return;
    }
    pattern = ((tile & 1) << 12) + (tile & 254) * 16;
    top = pattern;
    bottom = pattern + 16;
    if (flags & 128) { top = pattern + 16; bottom = pattern; }
    DrawTile(sx, sy, top, pal, flags, 1);
    DrawTile(sx, sy + tileSize, bottom, pal, flags, 1);
}

void Paint() {
    int row, col, changed, signature, scanned, drawn, i, mode, cell;
    if (!(mask & 8)) return;$extra_paint_reset
    mode = ctrl & 40;
    changed = 0;
    for (i = 0; i < 64; i++) {
        if (oam[i * 4] >= 239 && lastSprites[i] == -1) continue;
        signature = SpriteSignature(i * 4);
        if (signature != lastSprites[i] || (signature != -1 && $sprite_changes)) {
            changed = 1;
            if (painted) changed |= RestoreSprite(lastSprites[i], lastSpriteMode);
            lastSprites[i] = signature;
        }
    }
    lastSpriteMode = mode;$extra_sprite_update
    if (scannedEpoch != backgroundEpoch) {
        scannedEpoch = backgroundEpoch;
        scanLeft = viewRows * viewCols;
    }
    drawn = 0;
    scanned = 0;
    while (dirtyCount > 0 && scanned < 52 && drawn < 12) {
        cell = dirtyCells[dirtyHead];
        dirtyHead = (dirtyHead + 1) & 63;
        dirtyCount--;
        drawn += PaintCell(cell & 31, cell >> 5, 0);
        scanned++;
    }
    for (; scanLeft > 0 && scanned < 52 && drawn < 12; scanned++) {
        row = viewRow + paintAt / viewCols;
        col = viewCol + paintAt % viewCols;
        drawn += PaintCell(col, row, 0);
        paintAt++;
        scanLeft--;
        if (paintAt == viewRows * viewCols) {
            paintAt = 0;
            if (!painted) {
                painted = 1;
                changed = 1;
            }
        }
    }
    changed |= drawn;
    if (!painted || !changed) return;
    // Lower OAM indexes appear in front when sprites overlap.
    for (i = 63; i >= 0; i--) if (lastSprites[i] != -1) PaintSprite(lastSprites[i]);
    Flush();
}

int Key(int code) {
    if (code == 17) return 128;
    if (code == 16) return 64;
    if (code == 19) return 32;
    if (code == 18) return 16;
    if (code == 20) return 1;
    if (code == 10) return 2;
    if (code == 21) return 8;
    if (code == 11) return 4;
    return 0;
}

void Status(int error) {
    SetColorRGB(6, 10, 23);
    FillRect(0, 0, swWidth - 1, swHeight - 1);
    SetColorRGB(98, 193, 245);
    if (error) DrawStr(8, 6, "NES: unsupported cartridge");
    else DrawStr(26, 64, "$loading");
    Flush();
}

void main() {
    int file, count, i;
    Status(0);
    file = FileOpen("$cart_name", 3);
    count = 0;
    if (file >= 0) {
        count = FileReadInt(file, &rom[0], 10245);
        if (FileClose(file) < 0) count = 0;
    }
    prgMask = ROM(4) * 16384 - 1;
    chrStart = 17 + prgMask; // iNES header plus the number of PRG bytes.
    viewCol = $view_col;
    viewRow = $view_row;
    viewCols = $view_cols;
    viewRows = $view_rows;
    tileSize = $tile_size;
    if (swWidth < viewCols * tileSize || swHeight < viewRows * tileSize || ROM(0) != 78 || ROM(1) != 69 ||
        ROM(2) != 83 || ROM(3) != 26 || (ROM(4) != 1 && ROM(4) != 2) || ROM(5) != 1 ||
        (ROM(6) & 254) || ROM(7) || count != chrStart + 8192) {
        Status(1);
        return;
    }
    vertical = ROM(6) & 1;$extra_startup
    originX = (swWidth - viewCols * tileSize) / 2;
    originY = (swHeight - viewRows * tileSize) / 2;
    viewRight = originX + viewCols * tileSize;
    viewBottom = originY + viewRows * tileSize;
    for (i = 0; i < viewCols * viewRows; i++) seen[i] = -1;
    scannedEpoch = -1;
    for (i = 0; i < 64; i++) lastSprites[i] = -1;
    hue[0] = 0xe5f0ff; hue[1] = 0x528fff; hue[2] = 0x7d6cff; hue[3] = 0xb24aff;
    hue[4] = 0xdf5eda; hue[5] = 0xff658e; hue[6] = 0xff704f; hue[7] = 0xffcb4f;
    hue[8] = 0xd9ca52; hue[9] = 0x87d351; hue[10] = 0x55df99; hue[11] = 0x3adcc9;
    hue[12] = 0x42c2f2;
    pc = CpuRead(65532) | (CpuRead(65533) << 8);
    sp = 253;
    irqOff = 1;
    pollPc = -1;
    currentColor = -1;
    ready = 1;
    SetTimer(20, 1);
}

${pad_helper}void EVENT_TIMEOUT() {
$timeout_vars
    if (!ready) return;
$pad_sample
    vblank = 128;
$nmi_schedule
    guestYield = 0;
$guest_limit
    for (i = 0; i < limit && !failed && !guestYield; i++) {
        if (nmiPending && !inNmi) Nmi();
        Step();
    }
    if (failed) {
        ResetTimer();
        Status(1);
        return;
    }
    Paint();$audio_tick
}

void EVENT_KEYPRESS() {
$pad_keypress
}
